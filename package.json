{
  "name": "rclone-webui-angular",
  "version": "0.9.1",
  "private": true,
  "scripts": {
    "build:dev": "ng build --configuration development",
    "build:embed": "ng build --configuration production,embed",
    "build:native": "ng build --configuration production,native",
    "build:standalone": "ng build --configuration production,standalone",
    "check-updates": "npm-check-updates",
    "extract-i18n": "ng extract-i18n",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "ng lint --fix",
    "lint:prettier": "prettier ./src --write",
    "ng": "ng",
    "start": "(npm run start:rclone & npm run start:angular & wait)",
    "start:angular": "ng serve ${REMOTE_CONTAINERS:+--host 0.0.0.0}",
    "start:rclone": "rclone rcd --rc-addr=127.0.0.1:5572 --rc-no-auth",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "ng build --watch --configuration development,embed"
  },
  "dependencies": {
    "@angular/animations": "^22.0.7",
    "@angular/cdk": "^22.0.5",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/material": "^22.0.5",
    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-browser-dynamic": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@angular/service-worker": "^22.0.7",
    "normalize.css": "^8.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "uuid": "^10.0.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@angular-devkit/build-angular": "^22.0.7",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.0.7",
    "@angular/cli": "~22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@angular/localize": "^22.0.7",
    "@types/jasmine": "^5.1.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^8.57.1",
    "eventemitter3": "^5.0.4",
    "jasmine-core": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.0.0",
    "ng-extract-i18n-merge": "^3.4.0",
    "npm-check-updates": "^22.2.9",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.5.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
